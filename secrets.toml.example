# Copy this file to ".streamlit/secrets.toml" and fill in your values.
# secrets.toml is ignored by git and must NEVER be shared or uploaded.

# ---- AI assistant (https://aistudio.google.com/apikey) ----------------------------------------
# Administrators can also paste the key inside the app: AI Assistant -> Gemini connection & key setup.
GEMINI_API_KEY = "paste-your-gemini-api-key-here"
# GEMINI_MODEL = "gemini-3.5-flash-lite"

# ---- E-mail for password-reset codes and username reminders (optional) ------------------------
# Any SMTP server works. Gmail example: smtp.gmail.com, port 587, starttls, and an "App password".
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_SECURITY = "starttls"        # "starttls", "ssl" (port 465) or "none"
# SMTP_USER = "you@company.com"
# SMTP_PASSWORD = "your-app-password"
# SMTP_FROM = "you@company.com"

# ---- Sessions ----------------------------------------------------------------------------------
# SESSION_TIMEOUT_MINUTES = 30      # automatic sign-out after this many idle minutes
